# Supabase project connection (do not commit the real .env.local — it is gitignored by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain suffix used to map a staff username to a placeholder Supabase Auth email,
# e.g. username "eric" -> "eric@staff.bemytea.internal". Must match the accounts
# already created in Supabase Auth (see staff_users_table_draft.md).
STAFF_EMAIL_DOMAIN=staff.bemytea.internal

# Secret used to sign the server-issued session cookie (HttpOnly/Secure/SameSite).
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-byte-secret
